# ---------------------------------------------------------------------------
# AdonisJS backend — copy to .env and fill in values.
# Local infra defaults match adonis-backend-new/docker-compose.yml.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_KEY=generate-with-node-ace-generate-key

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://moringa:moringa123@127.0.0.1:5432/moringa_db

# Auth
JWT_SECRET=change-me

# URLs
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
API_PUBLIC_URL=http://localhost:5000/api/v1
CORS_ORIGINS=http://localhost:3000

# Redis (BullMQ + cache)
REDIS_URL=redis://127.0.0.1:6380
REDIS_CACHE_TTL_SECONDS=

# SMTP / email (Nodemailer + Handlebars templates)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Moringa Store <no-reply@example.com>"

# Razorpay payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Media storage (Cloudinary) — or STORAGE_PROVIDER=local for filesystem
STORAGE_PROVIDER=cloudinary
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=
STORAGE_CLOUDINARY_FOLDER=
STORAGE_CLOUDINARY_PUBLIC_URL=
STORAGE_CLOUDINARY_UPLOAD_PRESET=
STORAGE_LOCAL_UPLOADS_PATH=./uploads

# RabbitMQ (notification transport; falls back to in-process queue when unset)
RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5672
NOTIFICATION_MAX_ATTEMPTS=
NOTIFICATION_RETRY_INTERVAL_MS=

# Error tracking (Sentry protocol — Sentry SaaS or self-hosted GlitchTip).
# Leave SENTRY_DSN empty to disable entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=true
