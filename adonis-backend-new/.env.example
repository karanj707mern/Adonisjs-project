# Database
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=verify-full"

# App
NODE_ENV=development
PORT=5000
APP_KEY=replace-with-a-long-random-secret-at-least-32-characters

# URLs
SITE_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-backend-url.com
API_PUBLIC_URL=https://your-backend-url.com
CORS_ORIGINS=https://your-domain.com

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=300

# Notifications
NOTIFICATION_RETRY_INTERVAL_MS=60000
NOTIFICATION_MAX_ATTEMPTS=3
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+17542772078
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMTP (configure with your provider credentials)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_FROM=Moringa Store <no-reply@shop.example.com>
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Payments
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_CURRENCY=INR

# Admin
ADMIN_EMAIL_1=admin1@example.com
ADMIN_EMAIL_2=admin2@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Storage
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_UPLOADS_PATH=./uploads

# Cloudinary example
# STORAGE_PROVIDER=cloudinary
# STORAGE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# STORAGE_CLOUDINARY_API_KEY=your-api-key
# STORAGE_CLOUDINARY_API_SECRET=your-api-secret
# STORAGE_CLOUDINARY_FOLDER=moringa-store
# STORAGE_CLOUDINARY_UPLOAD_PRESET=Moringa-Store-Images
# STORAGE_CLOUDINARY_PUBLIC_URL=https://res.cloudinary.com/your-cloud-name

# RabbitMQ
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest
# RABBITMQ_VHOST=/
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Security notes:
# - Never commit real secrets to source control.
# - Use Render dashboard / secrets manager for production values.
# - Rotate any credential that was previously committed.
