{
  "name": "moringa-backend",
  "version": "2.0.0",
  "description": "Moringa e-commerce backend API built with AdonisJS and Fastify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build --production --no-assets",
    "start": "node server.js",
    "db:migrate": "node ace migration:run",
    "db:seed": "node ace db:seed",
    "db:rollback": "node ace migration:rollback",
    "db:refresh": "node ace migration:refresh",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "redis:cli": "redis-cli -h localhost -p 6379",
    "mq:setup": "node ace queue:work",
    "websocket:server": "node ace websocket:serve"
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.0.0",
    "@adonisjs/core": "^6.11.0",
    "@adonisjs/cors": "^2.0.0",
    "@adonisjs/lucid": "^21.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/redis": "^7.0.0",
    "@adonisjs/repl": "^4.0.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/websocket": "^1.0.12",
    "@prisma/client": "^6.19.3",
    "@fastify/cors": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.2.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/compress": "^6.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/csrf-protection": "^7.0.0",
    "@fastify/static": "^8.1.0",
    "@fastify/multipart": "^8.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ioredis": "^5.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "socket.io": "^4.8.3",
    "bullmq": "^5.79.3",
    "amqplib": "^2.0.1",
    "cloudinary": "^2.5.0",
    "sharp": "^0.33.5",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.0",
    "multer": "^2.0.0",
    "handlebars": "^4.7.9",
    "razorpay": "^2.9.6",
    "geoip-lite": "^2.0.3",
    "svg-captcha": "^1.4.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.0",
    "luxon": "^3.5.0",
    "date-fns": "^4.1.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^1.0.0",
    "@adonisjs/prettier-config": "^1.0.0",
    "@adonisjs/tsconfig": "^1.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^9.0.0",
    "@types/amqplib": "^0.10.8",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.7.0",
    "typescript": "~5.6.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@types/node": "^22.0.0"
  },
  "eslintConfig": {
    "extends": [
      "@adonisjs/eslint-config/extension"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
