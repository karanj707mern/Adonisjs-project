generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String
  isEmailVerified     Boolean   @default(false) @map("is_email_verified")
  role                Role      @default(USER)
  authProvider        AuthProvider @default(LOCAL) @map("auth_provider")
  googleId            String?   @unique @map("google_id")
  phoneNumber         String?
  avatar              String?
  refreshToken        String?   @unique @map("refresh_token")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  addressLine1        String?   @map("address_line1")
  addressLine2        String?   @map("address_line2")
  city                String?
  state               String?
  postalCode          String?
  country             String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  addresses      UserAddress[]
  orders         Order[]
  reviews        Review[]
  reviewComments ReviewComment[]
  sessions       Session[]
  wishlistItems  Wishlist[]
  cartItems      CartItem[]
  recentlyViewed RecentlyViewed[]
  auditLogs      AdminAuditLog[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]
}

model UserAddress {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  label         String
  recipientName String    @map("recipient_name")
  phoneNumber   String    @map("phone_number")
  addressLine1  String    @map("address_line1")
  addressLine2  String?   @map("address_line2")
  city          String
  state         String
  postalCode    String    @map("postal_code")
  country       String
  isDefault     Boolean   @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  price         Float
  description   String
  image         String
  stock         Int
  slug          String   @unique
  sku           String   @unique
  compareAtPrice Float?  @map("compare_at_price")
  brand         String?
  tags          String[]
  seoTitle      String?   @map("seo_title")
  seoDescription String?  @map("seo_description")
  weightGrams   Int?      @map("weight_grams")
  isActive      Boolean   @default(true)
  isNewArrival  Boolean   @default(false) @map("is_new_arrival")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  reviews          Review[]
  wishlistItems    Wishlist[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  recentlyViewed   RecentlyViewed[]
  abandonedCarts   AbandonedCart[]
}

model CartItem {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  productId      Int      @map("product_id")
  quantity       Int
  guestCartToken String?   @map("guest_cart_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([guestCartToken, productId])
  @@index([userId])
  @@index([guestCartToken])
}

model Order {
  id                    Int      @id @default(autoincrement())
  userId                Int      @map("user_id")
  total                 Float
  status                OrderStatus @default(PENDING)
  subtotal              Float
  shippingAmount        Float    @map("shipping_amount")
  taxAmount             Float    @map("tax_amount")
  handlingAmount        Float?   @map("handling_amount")
  codAmount             Float?   @map("cod_amount")
  shippingType          String    @map("shipping_type")
  paymentMethod         String    @map("payment_method")
  recipientName         String    @map("recipient_name")
  phoneNumber           String    @map("phone_number")
  addressLine1          String    @map("address_line1")
  addressLine2          String?   @map("address_line2")
  city                  String
  state                 String
  postalCode            String    @map("postal_code")
  country               String
  courierName           String?   @map("courier_name")
  trackingNumber        String?   @map("tracking_number")
  deliveredAt           DateTime? @map("delivered_at")
  estimatedDeliveryAt   DateTime? @map("estimated_delivery_at")
  outForDeliveryAt      DateTime? @map("out_for_delivery_at")
  paidAt                DateTime? @map("paid_at")
  shippedAt             DateTime? @map("shipped_at")
  razorpayOrderId       String?   @unique @map("razorpay_order_id")
  razorpayPaymentId     String?   @unique @map("razorpay_payment_id")
  couponCode            String?   @map("coupon_code")
  refund                Json?
  adminNotes            String?   @map("admin_notes")
  expiresAt             DateTime? @map("expires_at")
  inventoryReserved     Boolean   @default(false) @map("inventory_reserved")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  activities OrderActivity[]
  reviews   Review[]
  notifications Notification[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  productId Int      @map("product_id")
  quantity  Int
  price     Float
  createdAt DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderActivity {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  status    String
  title     String
  detail    String
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id                Int      @id @default(autoincrement())
  userId            Int?     @map("user_id")
  productId         Int      @map("product_id")
  guestWishlistToken String? @map("guest_wishlist_token")
  createdAt         DateTime @default(now()) @map("created_at")

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([guestWishlistToken, productId])
  @@index([userId])
  @@index([guestWishlistToken])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  orderId   Int?     @map("order_id")
  rating    Int
  title     String
  content   String
  status    ReviewStatus @default(PENDING)
  adminNote String?   @map("admin_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id])
  comments ReviewComment[]

  @@unique([userId, productId])
  @@index([productId])
  @@index([status])
}

model ReviewComment {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  userId    Int      @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review_comments")
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?  @map("cover_image")
  published   Boolean  @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Session {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  refreshToken       String   @unique @map("refresh_token")
  userAgent          String?  @map("user_agent")
  ip                 String?
  country            String?
  city               String?
  device             String?
  browser            String?
  os                 String?
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  lastUsedAt         DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model HeroImage {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model NewArrival {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  comingSoon Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("new_arrival")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  CouponDiscountType @map("discount_type")
  discountValue Float    @map("discount_value")
  minOrderValue Float?   @map("min_order_value")
  maxDiscount   Float?   @map("max_discount")
  usageLimit    Int?     @map("usage_limit")
  usedCount     Int      @default(0) @map("used_count")
  isActive      Boolean  @default(true)
  validFrom     DateTime @map("valid_from")
  validUntil    DateTime @map("valid_until")
  perUserLimit  Int?     @map("per_user_limit")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  usages CouponUsage[]
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  userId    Int      @map("user_id")
  orderId   Int      @map("order_id")
  usedAt    DateTime @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
}

model StoreSettings {
  id                      Int      @id @default(1)
  shippingCharge           Float    @map("shipping_charge")
  taxRate                 Float    @map("tax_rate")
  freeShippingThreshold   Float    @map("free_shipping_threshold")
  codCharge               Float?   @map("cod_charge")
  expressShippingCharge   Float?   @map("express_shipping_charge")
  handlingCharge          Float?   @map("handling_charge")
  sameDayShippingCharge   Float?   @map("same_day_shipping_charge")
  shippingOptions         Json?    @map("shipping_options")
  shippingZones           Json?    @map("shipping_zones")
  codEnabled              Boolean  @default(true) @map("cod_enabled")
  maxCodOrderValue        Float?   @map("max_cod_order_value")
  allowInternationalCod   Boolean  @default(false) @map("allow_international_cod")
  autoCancelPendingMinutes Int     @default(30) @map("auto_cancel_pending_minutes")
  updatedAt               DateTime @updatedAt @map("updated_at")
}

model Notification {
  id                 Int             @id @default(autoincrement())
  userId             Int?            @map("user_id")
  orderId            Int?            @map("order_id")
  type               NotificationType
  channel            NotificationChannel
  recipient          String
  subject            String
  body               String
  payload            Json?
  status             NotificationStatus @default(PENDING)
  attempts           Int             @default(0)
  maxAttempts        Int             @default(3) @map("max_attempts")
  lastError          String?         @map("last_error")
  providerMessageId  String?         @map("provider_message_id")
  scheduledAt        DateTime?       @map("scheduled_at")
  sentAt             DateTime?       @map("sent_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("notifications")
}

model NotificationPreference {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  subject   String
  htmlBody  String   @map("html_body")
  textBody  String?  @map("text_body")
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    Int?     @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  viewedAt  DateTime @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("recently_viewed")
  @@index([userId])
  @@index([productId])
}

model AbandonedCart {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  guestToken  String?  @map("guest_token")
  productId   Int      @map("product_id")
  quantity    Int
  recovered   Boolean  @default(false)
  recoveredAt DateTime? @map("recovered_at")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("abandoned_cart")
  @@index([userId])
  @@index([guestToken])
  @@index([expiresAt])
}

model GiftCard {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(32)
  initialAmount  Float    @map("initial_amount")
  remainingAmount Float   @map("remaining_amount")
  currency       String   @default("INR")
  isActive       Boolean  @default(true)
  redeemedBy     Int?     @map("redeemed_by")
  redeemedAt     DateTime? @map("redeemed_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  OUT_FOR_DELIVERY
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_ALERT
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_STATUS_UPDATED
  ORDER_CANCELLED
  WELCOME
  EMAIL_VERIFIED
  PROFILE_UPDATED
  ADDRESS_ADDED
  ADDRESS_UPDATED
  ADDRESS_DELETED
  REVIEW_POSTED
  COMMENT_POSTED
  BLOG_POSTED
  BLOG_UPDATED
  BLOG_DELETED
  SUPPORT_ISSUE_CREATED
  SUPPORT_ISSUE_UPDATED
  NEW_USER_REGISTERED
  LOW_STOCK
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
