{
  "name": "moringa-backend",
  "version": "1.0.0",
  "description": "Moringa Products e-commerce backend built with AdonisJS v6, Prisma and PostgreSQL.",
  "author": "Karan Patel <karanj707mern@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ace build",
    "start": "node build/bin/server.js",
    "dev": "node ace serve --watch",
    "serve": "node ace serve",
    "console": "node ace repl",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:email-templates": "ts-node prisma/seed-email-templates.ts",
    "orders:backfill-legacy": "ts-node prisma/backfill-legacy-orders.ts",
    "convert-webp": "ts-node scripts/convert-images-to-webp.ts",
    "reset-admin-pass": "ts-node scripts/reset-admin-password.ts",
    "storage:migrate": "node scripts/migrate-images-to-cloudinary.js",
    "storage:migrate:dry-run": "node scripts/migrate-images-to-cloudinary.js --dry-run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "lint": "eslint . --ext=ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adonisjs/bodyparser": "^10.0.0",
    "@adonisjs/core": "^6.18.0",
    "@adonisjs/cors": "^2.0.0",
    "@adonisjs/limiter": "^2.0.0",
    "@adonisjs/logger": "^6.0.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^7.0.0",
    "@adonisjs/shield": "^8.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/validator": "^12.0.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@vinejs/vine": "^3.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.3",
    "cloudinary": "^2.10.0",
    "cookie": "^1.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.3",
    "svg-captcha": "^1.4.0"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^2.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.0.0",
    "@types/pino": "^7.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
