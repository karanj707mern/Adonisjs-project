{
  "name": "qwikcity-frontend",
  "description": "Moringa products store frontend migrated from Next.js to Qwik City. Responsive UI for browsing products, managing carts, and placing orders.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "postbuild": "node scripts/postbuild.mjs",
    "dev": "vite --mode ssr",
    "preview": "node scripts/postbuild.mjs && qwik build && node --import ./register-loader.mjs node-server.mjs",
    "start": "node scripts/postbuild.mjs && node --import ./register-loader.mjs node-server.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-qwik": "^1.20.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "undici": "*",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7"
  }
}
