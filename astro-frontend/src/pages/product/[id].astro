---
import MainLayout from '~/layouts/MainLayout.astro'
import ProductDetailsClient from '../../../legacy-next-app/(main)/product/[id]/ProductDetailsClient'
import { API_BASE_URL } from '~/lib/config'

const { id } = Astro.params
const API_BASE = API_BASE_URL
const ASSET_BASE = API_BASE.replace(/\/api\/v\d+\/?$/, '')

function resolveImage(value?: string | null): string | undefined {
  if (!value) return undefined
  if (/^https?:\/\//.test(value)) return value
  return `${ASSET_BASE}${value}`
}

function serializeJsonLd(data: Record<string, unknown>): string {
  return JSON.stringify(data).replace(/</g, '\\u003c')
}

const [productRes, reviewsRes] = await Promise.all([
  fetch(`${API_BASE}/product/${id}`),
  fetch(`${API_BASE}/review/product/${id}`),
])

let product = null
let reviews = null

if (productRes.ok) {
  product = await productRes.json()
}
if (reviewsRes.ok) {
  reviews = await reviewsRes.json()
}

if (!product) {
  return
}

const productImage = product?.image ? resolveImage(product.image) : undefined
const siteUrl = process.env.SITE_URL || process.env.PUBLIC_SITE_URL || ''
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Shop',
      item: `${siteUrl}/shop`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: product?.name || 'Product',
      item: `${siteUrl}/product/${id}`,
    },
  ],
}
const averageRating = Number(reviews?.summary?.averageRating) || 0
const reviewCount = Number(reviews?.summary?.reviewCount) || 0
const productJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.seoDescription || product.description,
  ...(productImage ? { image: productImage } : {}),
  ...(product.sku ? { sku: product.sku } : {}),
  ...(product.brand
    ? { brand: { '@type': 'Brand', name: product.brand } }
    : {}),
  offers: {
    '@type': 'Offer',
    url: `${siteUrl}/product/${id}`,
    price: product.price,
    priceCurrency: 'INR',
    availability:
      product.stock > 0
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
  },
  ...(averageRating > 0 && reviewCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: averageRating.toFixed(1),
          reviewCount,
          bestRating: '5',
          worstRating: '1',
        },
      }
    : {}),
}
---
<MainLayout title={product?.seoTitle || product?.name || 'Product'}>
  <ProductDetailsClient product={product ?? null} initialReviews={reviews} client:only="react" />
  {productImage ? (
    <link rel="preload" as="image" href={productImage} />
  ) : null}
  <script type="application/ld+json" set:html={serializeJsonLd(breadcrumb)} />
  <script type="application/ld+json" set:html={serializeJsonLd(productJsonLd)} />
</MainLayout>
