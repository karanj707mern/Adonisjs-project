---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Page not found">
  <main class="mx-auto max-w-7xl px-4 py-20 text-center">
    <h1 class="font-serif text-4xl text-[var(--text-primary)]">404</h1>
    <p class="mt-4 text-[var(--text-secondary)]">Page not found</p>
    <a href="/" class="btn-primary mt-6 inline-block">Back to store</a>
  </main>
</Layout>
