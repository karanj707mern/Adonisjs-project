---
import Layout from './Layout.astro'
import AdminGuard from '../components/admin/AdminGuard'
import AdminSidebar from '../components/admin/AdminSidebar'

const siteUrl = Astro.site?.toString() || ''
---
<Layout title="Admin">
  <AdminGuard>
    <div class="flex min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)]">
      <AdminSidebar client:load />
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-40 flex h-14 items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-secondary)]/95 px-4 backdrop-blur lg:px-10">
          <div class="flex items-center gap-3">
            <p class="text-sm font-semibold text-[var(--text-primary)] lg:hidden">Moringa Admin</p>
          </div>
          <div class="flex items-center gap-2">
            <a href={siteUrl} target="_blank" class="btn-vibrant inline-flex items-center gap-2 rounded-full border-2 border-[var(--border-color)] px-3 py-1.5 text-xs font-semibold text-white">Preview Website</a>
          </div>
        </header>
        <main class="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-10 lg:py-8 pt-[env(safe-area-inset-top)]">
          <div class="mx-auto max-w-6xl">
            <slot />
          </div>
        </main>
      </div>
    </div>
  </AdminGuard>
</Layout>
