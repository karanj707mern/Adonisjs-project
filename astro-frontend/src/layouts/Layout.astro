---
interface Props {
  title?: string
  description?: string
  children: any
}

const title = Props.title ? `${Props.title} | Moringa Store` : 'Moringa Store Online'
const description = Props.description || 'Shop premium moringa powder, tea, capsules, oil, and wellness bundles from Moringa Store Online.'
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#166534" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://my-nest-project-pearl.vercel.app" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)]">
    <slot />
  </body>
</html>
